    <title>Business English Exam</title>
    <style>
        :root { --primary: #2c3e50; --accent: #d4af37; --bg: #f4f7f6; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: var(--bg); margin: 0; padding: 10px; line-height: 1.6; }
        .container { max-width: 800px; background: white; margin: 20px auto; padding: 25px; border-radius: 15px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
        h1 { color: var(--primary); text-align: center; border-bottom: 3px solid var(--accent); padding-bottom: 10px; margin-bottom: 30px; }
        .question-box { margin-bottom: 25px; padding: 15px; border-right: 5px solid var(--primary); background: #f9f9f9; border-radius: 0 8px 8px 0; }
        .question-text { font-weight: bold; margin-bottom: 10px; color: #34495e; }
        .options label { display: block; margin: 8px 0; cursor: pointer; padding: 8px; border-radius: 5px; transition: 0.3s; }
        .options label:hover { background: #eef2f3; }
        input[type="radio"] { margin-left: 10px; cursor: pointer; }
        #name-section { text-align: center; margin-bottom: 40px; }
        input[type="text"] { padding: 12px; width: 85%; font-size: 16px; border-radius: 8px; border: 2px solid #ddd; outline: none; transition: 0.3s; }
        input[type="text"]:focus { border-color: var(--primary); }
        .btn-submit { background: var(--primary); color: white; border: none; padding: 15px 30px; border-radius: 8px; cursor: pointer; font-size: 18px; width: 100%; margin-top: 20px; font-weight: bold; }
        .btn-submit:hover { background: #1a252f; }
        
        /* تصميم الشهادة */
        #certificate-area { display: none; text-align: center; border: 15px double var(--accent); padding: 40px; background: #fff; position: relative; margin-top: 20px; }
        .cert-header { font-size: 24px; color: #7f8c8d; margin-bottom: 5px; }
        .cert-title { font-size: 45px; color: var(--primary); margin: 15px 0; font-family: 'Times New Roman', serif; }
        .student-name { font-size: 35px; color: var(--accent); font-weight: bold; text-decoration: underline; margin: 20px 0; }
        .cert-body { font-size: 20px; color: #34495e; }
        .score-box { font-size: 28px; color: #27ae60; font-weight: bold; margin: 15px 0; }
        .footer-sign { margin-top: 50px; display: flex; justify-content: space-between; font-weight: bold; color: #7f8c8d; }
    </style>
</head>
